# Copy this file to .env and fill in your own values. Never commit .env.

PORT=5000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_database_password
DB_NAME=career_skill_analyzer

# At least 16 characters. Use a long random value.
JWT_SECRET=change_this_to_a_long_random_secret
# For example 7d, 12h, 30m, or a number of seconds.
JWT_EXPIRES_IN=7d

# Selected AI provider: Google Gemini.
# If the key or model is left as a "your_..." placeholder, the app runs with the rule-based fallback.
AI_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here
AI_MODEL=your_selected_gemini_model
AI_TIMEOUT_MS=30000
